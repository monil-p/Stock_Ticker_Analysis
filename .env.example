# Copy this file to .env and fill in the real values.
# .env is gitignored; this file is committed as documentation.

# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Absolute path to the BigQuery service-account key.
# Keep the key file OUTSIDE this repo, and use FORWARD SLASHES -- dbt
# interpolates this into a double-quoted YAML string where \U is an
# invalid escape sequence.
GCP_KEYFILE=

GCP_PROJECT_ID=
BQ_RAW_DATASET=raw
BQ_LOCATION=US
